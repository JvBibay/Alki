# Optional: send quick-add text to the server parser instead of parsing in the browser.
NEXT_PUBLIC_USE_SERVER_PARSER=false

# Optional: URL of the Python FastAPI parser (see /python). If unset, /api/parse uses the TypeScript parser.
PARSER_URL=http://127.0.0.1:8000

# Optional: push reminders (iPhone, desktop, Android). The PUBLIC half of your VAPID key pair; see the README ("Push reminders").
# Generate a pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Plans: how people pay for now (GCash). Shown in the app, so use the number you want people to pay.
# After you confirm a payment, activate their plan in /admin → "Plans: activate after payment".
NEXT_PUBLIC_PAY_GCASH_NAME=
NEXT_PUBLIC_PAY_GCASH_NUMBER=
# Your QR Ph picture, saved inside /public (for example public/pay-qr.png), then set to: /pay-qr.png
NEXT_PUBLIC_PAY_QR=
# Where people send their payment proof: an email address, or a Messenger/Viber link.
NEXT_PUBLIC_PAY_CONTACT=

# Legal pages (/terms and /privacy): who runs Kwenta and where people can reach you (a real, monitored email).
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=

# Sign-in captcha (Cloudflare Turnstile, free). Leave empty to run without one.
# Add the SITE key here (it is public), put the SECRET key in Supabase, and set this in Vercel too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
